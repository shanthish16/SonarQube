pipeline {
    agent any

    environment {
        // --- DOCKER CONFIG ---
        DOCKER_IMAGE   = "shanthishda/jenkins-custom" 
        DOCKER_TAG     = "${env.BUILD_NUMBER}"
        DOCKER_CREDS   = "docker-hub-creds" 

        // --- DEPLOYMENT CONFIG (Same as Jenkins Server) ---
        TARGET_EC2_IP  = "13.53.45.35"
        SSH_CRED_ID    = "ec2-ssh-key"
        APP_NAME       = "jenkins-custom-app"
    }

    stages {
        // Stage 1: Checkout code from your GitHub
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Stage 2: Docker Build & Push to Docker Hub
        stage('Docker Build & Push') {
            steps {
                script {
                    // Logs in using your 'docker-hub-creds'
                    docker.withRegistry('', DOCKER_CREDS) {
                        def customImage = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                        customImage.push()
                        customImage.push("latest") 
                    }
                }
            }
        }

        // Stage 3: Deploy on EC2
        stage('Deploy on EC2') {
            steps {
                sshagent([SSH_CRED_ID]) {
                    sh """
                        # Connect to the server, pull the image, and restart the container
                        ssh -o StrictHostKeyChecking=no ubuntu@${TARGET_EC2_IP} "
                            docker pull ${DOCKER_IMAGE}:latest
                            docker stop ${APP_NAME} || true
                            docker rm ${APP_NAME} || true
                            docker run -d --name ${APP_NAME} -p 8080:8080 ${DOCKER_IMAGE}:latest
                        "
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Successfully deployed ${DOCKER_IMAGE}:${DOCKER_TAG} to ${TARGET_EC2_IP}"
        }
    }
}
