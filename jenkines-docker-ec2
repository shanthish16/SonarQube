pipeline {
    agent any

    environment {
        // --- DOCKER CONFIG ---
        IMAGE_NAME   = "shanthishda/jenkins-custom" 
        IMAGE_TAG     = "${env.BUILD_NUMBER}"
        DOCKER_CREDS   = "docker-hub-creds" 

        // --- DEPLOYMENT CONFIG ---
        EC2_USER      = "ubuntu" 
        EC2_HOST      = "13.53.45.35"
        SSH_CRED_ID    = "ec2-ssh-key"
        APP_NAME       = "my-java-app"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('', DOCKER_CREDS) {
                        def myApp = docker.build("${IMAGE_NAME}:${IMAGE_TAG}", "-f Docker-1 .")
                        myApp.push()
                        myApp.push("latest") 
                    }
                }
            }
        }

        stage('Deploy on EC2') {
            steps {
                sshagent([SSH_CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "
                            docker pull ${IMAGE_NAME}:latest
                            docker stop ${APP_NAME} || true
                            docker rm ${APP_NAME} || true
                            docker run -d --name ${APP_NAME} -p 8081:8080 ${IMAGE_NAME}:latest
                        "
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Successfully deployed to http://${EC2_HOST}:8081"
        }
        failure {
            echo "Pipeline failed. Check logs for bracket or credential errors."
        }
    }
} // This is the final bracket that closes the 'pipeline' block
